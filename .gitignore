# Python / tooling
__pycache__/
*.pyc
.pytest_cache
.vscode
.DS_Store
*.patch

# ---------------------------------------------------------------------------
# Test outputs: files the test suite writes into data/testing_data.
# Everything listed here is regenerated by `pytest`. The `!` lines re-include
# the few generated files that a test reads *before* the test that writes them
# has run, so a fresh clone still passes.
# ---------------------------------------------------------------------------

# ORCA outputs not part of the tracked test set
data/testing_data/ReadORCA6Outputs/CoIILig-S4_PBE0-def2-TZVP-Opt-Freq-DEFGRID3
data/testing_data/ReadORCA6Outputs/Cr*
data/testing_data/ReadORCA6Outputs/Fe*
data/testing_data/ReadORCA6Outputs/Mn*

# .mol files parsed from ORCA outputs (test_moleculeset_ReadORCA6OptOutput,
# test_molecule_ReadORCA6OutputGradients). Two are read earlier by
# test_molecule_core_functions (test_MoleculeToASEMolecule, test_OptimiseGeometry_tblite).
data/testing_data/ReadORCA6Outputs/*_Gradient-Output/*
!data/testing_data/ReadORCA6Outputs/CoIILig-S2_Gradient-Output/BIHGEE-S4_opt0.mol
!data/testing_data/ReadORCA6Outputs/CoIILig-S2_Gradient-Output/YUDGUA02-S4_opt21.mol

# SOAP descriptor .mol files (test_moleculeset_ReadMolFiles_GetSOAPDes_WriteMolFiles)
data/testing_data/AtomicDescriptors/

# tblite optimisation outputs (test_OptimiseGeometry_tblite)
data/testing_data/tbliteTests/

# Generated PySCF / Psi4 input scripts and parsed outputs
# (the *_PySCFOutput.* and Psi4 .out/.log/.meta.json/.fock reference outputs stay tracked)
data/testing_data/PySCFTests/*_calc.py
data/testing_data/Psi4Tests/benzene_calc/benzene_calc.py
data/testing_data/Psi4Tests/benzene_calc/vis_grads/
data/testing_data/Psi4Tests/water_calc/water-calcs/*.py
data/testing_data/Psi4Tests/water_calc/water-calcs/submit_jobs.sh
data/testing_data/Psi4Tests/water_calc/water-calcs_Psi4Output/
data/testing_data/Psi4Tests/water_calc/water-calcs_Psi4Output.csv
data/testing_data/Psi4Tests/water_calc/water-calcs_resrc_est.csv
data/testing_data/Psi4Tests/water_calc/vis-grads/

# BH9 .mol files written from the .xyz inputs (test_ReadXYZFile_BH9,
# test_WriteSMARTSString_BH9). Pericyclic42_* is not generated, so it stays tracked.
data/testing_data/TS/BH9/*.mol
!data/testing_data/TS/BH9/Pericyclic42_*.mol

# MOBH35 .xyz/.mol files split out of MOBH35_geom.txt (test_ReadXYZFiles_MOBH)
data/testing_data/TS/MOBH35/MOBH35_*.xyz
data/testing_data/TS/MOBH35/MOBH35_*_TS.mol

# test_molecule_core_functions outputs. benzene.mol, benzene_stripped.mol,
# water_*.mol and benzene_water_cation.mol stay tracked: other test files read
# them first, and test_add_molecule_to_molecule fails before it writes
# benzene_water_cation.mol.
data/testing_data/InitialTests/AromaticSandwich.mol
data/testing_data/InitialTests/AromaticSandwichUFF.mol
data/testing_data/InitialTests/BIHGEE-S4_opt0_SOAPDes.mol
